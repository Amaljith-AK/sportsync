generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id          Int        @id
  name        String
  shortName   String?
  tla         String?
  crestUrl    String?
  stadium     String?
  founded     Int?
  manager     String?
  clubColors  String?
  homeMatches Match[]    @relation("HomeTeam")
  awayMatches Match[]    @relation("AwayTeam")
  standings   Standing[]
}

model Match {
  id              Int      @id
  competitionCode String
  season          Int
  matchday        Int?
  utcDate         DateTime
  status          String
  homeTeamId      Int
  awayTeamId      Int
  homeScore       Int?
  awayScore       Int?
  winner          String?
  lastSyncedAt    DateTime @updatedAt

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id])

  prediction Prediction?

  @@index([status])
  @@index([utcDate])
}

model Standing {
  id              Int      @id @default(autoincrement())
  competitionCode String
  season          Int
  teamId          Int
  position        Int
  playedGames     Int
  won             Int
  draw            Int
  lost            Int
  points          Int
  goalsFor        Int
  goalsAgainst    Int
  goalDifference  Int
  lastSyncedAt    DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@unique([competitionCode, teamId])
}

model Prediction {
  id         Int      @id @default(autoincrement())
  matchId    Int      @unique
  homeWinPct Float
  drawPct    Float
  awayWinPct Float
  computedAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])
}
