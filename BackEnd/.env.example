# Server
PORT=4000
NODE_ENV=development

# Database (adjust user/password/db name to your local Postgres setup)
DATABASE_URL="postgresql://postgres:@localhost:5432/sportsync?schema=public"

# football-data.org — standings, fixtures, teams (non-live)
FOOTBALL_DATA_KEY=your_football_data_org_key_here
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# API-Football (API-SPORTS) — live/in-play only
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Sync/poll intervals (in minutes/seconds — used later by scheduler + livePoll service)
SYNC_INTERVAL_MINUTES=30
LIVE_POLL_INTERVAL_SECONDS=60